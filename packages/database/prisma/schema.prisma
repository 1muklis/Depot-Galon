// ============================================================
// E-COMMERCE GALON AIR - Prisma Schema (PostgreSQL)
// Role: ADMIN, COURIER, CUSTOMER
// Fitur: produk, stok, keranjang, order, payment gateway,
//        pengiriman kurir, deposit & tukar galon kosong,
//        langganan rutin, voucher, review, notifikasi
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  ADMIN
  COURIER
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProductType {
  GALON_ISI_ULANG // refill (tukar galon kosong)
  GALON_BARU // galon + isi (beli galon baru)
  AIR_KEMASAN // botol / gelas / kardus
  DISPENSER
  AKSESORI // pompa galon, tutup, rak, dll
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  READY_FOR_DELIVERY
  ON_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  PARTIAL_REFUND
  REFUNDED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  VIRTUAL_ACCOUNT
  EWALLET
  QRIS
  CREDIT_CARD
  RETAIL_OUTLET
}

enum PaymentGateway {
  MIDTRANS
  XENDIT
  DOKU
  DUITKU
  MANUAL
  COD
}

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  ACCEPTED
  PICKED_UP
  ON_THE_WAY
  ARRIVED
  DELIVERED
  FAILED
  RETURNED
}

enum CourierStatus {
  OFFLINE
  AVAILABLE
  BUSY
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
}

enum GallonMovementType {
  DELIVERED_FULL // galon isi diantar ke customer
  COLLECTED_EMPTY // galon kosong diambil dari customer
  DEPOSIT_PAID // customer bayar deposit galon
  DEPOSIT_REFUND // deposit dikembalikan
}

enum VoucherType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum SubscriptionFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum NotificationType {
  ORDER
  PAYMENT
  DELIVERY
  PROMO
  SYSTEM
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  phone           String?    @unique
  password        String
  avatar          String?
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  // Relasi per role
  customerProfile CustomerProfile?
  courierProfile  CourierProfile?
  adminProfile    AdminProfile?

  // Relasi umum
  addresses       Address[]
  cart            Cart?
  orders          Order[]
  reviews         Review[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  passwordResets  PasswordReset[]
  subscriptions   Subscription[]
  voucherUsages   VoucherUsage[]
  auditLogs       AuditLog[]
  stockMovements  StockMovement[]

  @@index([role, status])
  @@map("users")
}

model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  position  String? // contoh: Super Admin, Staff Gudang, Finance
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model CustomerProfile {
  id           String    @id @default(cuid())
  userId       String    @unique
  birthDate    DateTime?
  gender       String?
  loyaltyPoint Int       @default(0)
  // Jumlah galon kosong milik toko yang sedang dipegang customer
  gallonsHeld  Int       @default(0)
  // Total deposit galon yang sedang ditahan
  depositHeld  Decimal   @default(0) @db.Decimal(12, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model CourierProfile {
  id            String        @id @default(cuid())
  userId        String        @unique
  vehicleType   String? // motor, mobil bak, dll
  vehiclePlate  String?
  licenseNumber String? // nomor SIM
  idCardNumber  String? // NIK
  status        CourierStatus @default(OFFLINE)
  currentLat    Float?
  currentLng    Float?
  lastLocationAt DateTime?
  maxCapacity   Int           @default(10) // maks galon per trip
  rating        Float         @default(0)
  totalDelivered Int          @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries Delivery[]
  zones      CourierZone[]

  @@index([status])
  @@map("courier_profiles")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ============================================================
// ALAMAT & ZONA PENGIRIMAN
// ============================================================

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String // Rumah, Kantor, dll
  recipientName String
  phone         String
  street        String
  detail        String? // patokan, blok, lantai
  village       String? // kelurahan
  district      String? // kecamatan
  city          String
  province      String
  postalCode    String?
  latitude      Float?
  longitude     Float?
  isDefault     Boolean  @default(false)
  zoneId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  zone          DeliveryZone?  @relation(fields: [zoneId], references: [id])
  orders        Order[]
  subscriptions Subscription[]

  @@index([userId])
  @@map("addresses")
}

model DeliveryZone {
  id           String   @id @default(cuid())
  name         String   @unique // contoh: Bandung Utara
  description  String?
  shippingFee  Decimal  @db.Decimal(12, 2)
  minOrder     Decimal  @default(0) @db.Decimal(12, 2)
  freeShippingMin Decimal? @db.Decimal(12, 2) // gratis ongkir di atas nominal ini
  estimatedMinutes Int  @default(60)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses Address[]
  couriers  CourierZone[]
  orders    Order[]

  @@map("delivery_zones")
}

model CourierZone {
  courierId String
  zoneId    String

  courier CourierProfile @relation(fields: [courierId], references: [id], onDelete: Cascade)
  zone    DeliveryZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([courierId, zoneId])
  @@map("courier_zones")
}

model DeliverySlot {
  id        String   @id @default(cuid())
  label     String // contoh: Pagi 08:00 - 11:00
  startTime String // "08:00"
  endTime   String // "11:00"
  capacity  Int      @default(50) // maks order per slot per hari
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  orders        Order[]
  subscriptions Subscription[]

  @@map("delivery_slots")
}

// ============================================================
// PRODUK & STOK
// ============================================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique // Aqua, Le Minerale, Cleo, dll
  slug      String   @unique
  logo      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  products Product[]

  @@map("brands")
}

model Product {
  id          String      @id @default(cuid())
  categoryId  String
  brandId     String?
  name        String
  slug        String      @unique
  sku         String      @unique
  description String?
  type        ProductType
  volumeLiter Float? // 19, 15, 5, 1.5, dll
  price       Decimal     @db.Decimal(12, 2)
  costPrice   Decimal?    @db.Decimal(12, 2)
  // Khusus galon
  requiresEmptyReturn Boolean @default(false) // wajib tukar galon kosong
  depositAmount       Decimal @default(0) @db.Decimal(12, 2) // deposit galon
  weightKg    Float? // 19L ~ 19-20 kg
  minOrderQty Int         @default(1)
  maxOrderQty Int?
  isActive    Boolean     @default(true)
  isFeatured  Boolean     @default(false)
  soldCount   Int         @default(0)
  ratingAvg   Float       @default(0)
  ratingCount Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  category      Category       @relation(fields: [categoryId], references: [id])
  brand         Brand?         @relation(fields: [brandId], references: [id])
  images        ProductImage[]
  stock         Stock?
  stockMovements StockMovement[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  priceTiers    ProductPriceTier[]
  subscriptionItems SubscriptionItem[]

  @@index([categoryId])
  @@index([type, isActive])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// Harga grosir: beli 5 galon lebih murah, dst
model ProductPriceTier {
  id        String  @id @default(cuid())
  productId String
  minQty    Int
  price     Decimal @db.Decimal(12, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, minQty])
  @@map("product_price_tiers")
}

model Stock {
  id          String   @id @default(cuid())
  productId   String   @unique
  quantity    Int      @default(0)
  reserved    Int      @default(0) // sudah di-order tapi belum dikirim
  minStock    Int      @default(10) // alert stok menipis
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stocks")
}

model StockMovement {
  id          String            @id @default(cuid())
  productId   String
  type        StockMovementType
  quantity    Int
  note        String?
  referenceId String? // orderId / PO id
  createdById String?
  createdAt   DateTime          @default(now())

  product   Product @relation(fields: [productId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id])

  @@index([productId, createdAt])
  @@map("stock_movements")
}

// ============================================================
// KERANJANG
// ============================================================

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ============================================================
// VOUCHER
// ============================================================

model Voucher {
  id            String      @id @default(cuid())
  code          String      @unique
  name          String
  description   String?
  type          VoucherType
  value         Decimal     @db.Decimal(12, 2) // persen atau nominal
  maxDiscount   Decimal?    @db.Decimal(12, 2)
  minPurchase   Decimal     @default(0) @db.Decimal(12, 2)
  usageLimit    Int? // total kuota
  perUserLimit  Int         @default(1)
  usedCount     Int         @default(0)
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  usages VoucherUsage[]
  orders Order[]

  @@map("vouchers")
}

model VoucherUsage {
  id        String   @id @default(cuid())
  voucherId String
  userId    String
  orderId   String   @unique
  createdAt DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])

  @@index([voucherId, userId])
  @@map("voucher_usages")
}

// ============================================================
// ORDER
// ============================================================

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique // contoh: GLN-20261126-0001
  userId        String
  addressId     String
  zoneId        String?
  slotId        String?
  voucherId     String?
  subscriptionId String?

  status        OrderStatus @default(PENDING_PAYMENT)

  // Snapshot alamat saat order (agar tidak berubah bila alamat diedit)
  shippingName    String
  shippingPhone   String
  shippingAddress String
  shippingLat     Float?
  shippingLng     Float?

  subtotal        Decimal @db.Decimal(12, 2)
  shippingFee     Decimal @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal @default(0) @db.Decimal(12, 2)
  depositAmount   Decimal @default(0) @db.Decimal(12, 2) // total deposit galon
  serviceFee      Decimal @default(0) @db.Decimal(12, 2) // biaya admin gateway
  totalAmount     Decimal @db.Decimal(12, 2)

  // Galon kosong yang akan ditukar saat pengantaran
  emptyGallonsToReturn Int @default(0)

  scheduledDate DateTime? // tanggal pengantaran diminta
  customerNote  String?
  adminNote     String?
  cancelReason  String?
  cancelledAt   DateTime?
  paidAt        DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  address      Address       @relation(fields: [addressId], references: [id])
  zone         DeliveryZone? @relation(fields: [zoneId], references: [id])
  slot         DeliverySlot? @relation(fields: [slotId], references: [id])
  voucher      Voucher?      @relation(fields: [voucherId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  items          OrderItem[]
  payments       Payment[]
  delivery       Delivery?
  statusHistory  OrderStatusHistory[]
  voucherUsage   VoucherUsage?
  gallonMovements GallonMovement[]
  refunds        Refund[]
  reviews        Review[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([scheduledDate])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  // Snapshot data produk saat order
  productName String
  sku         String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  depositPerUnit Decimal @default(0) @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String? // userId
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_histories")
}

// ============================================================
// PAYMENT & PAYMENT GATEWAY
// ============================================================

model Payment {
  id             String         @id @default(cuid())
  orderId        String
  gateway        PaymentGateway
  method         PaymentMethod
  status         PaymentStatus  @default(PENDING)

  amount         Decimal        @db.Decimal(12, 2)
  fee            Decimal        @default(0) @db.Decimal(12, 2)
  currency       String         @default("IDR")

  // Data dari payment gateway
  externalId     String?        @unique // order_id / external_id yang dikirim ke gateway
  transactionId  String?        @unique // id transaksi dari gateway
  paymentCode    String? // nomor VA / kode bayar retail
  bankCode       String? // BCA, BNI, MANDIRI, dll
  paymentUrl     String? // snap redirect_url / invoice_url
  snapToken      String? // token Midtrans Snap
  qrString       String? // payload QRIS
  rawResponse    Json? // response lengkap saat create transaksi

  expiresAt      DateTime?
  paidAt         DateTime?
  failureReason  String?

  // Untuk pembayaran manual / COD
  proofImage     String? // bukti transfer
  verifiedBy     String? // admin yang memverifikasi
  verifiedAt     DateTime?
  codCollectedBy String? // kurir yang menerima uang COD

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order    Order            @relation(fields: [orderId], references: [id])
  webhooks PaymentWebhookLog[]
  refunds  Refund[]

  @@index([orderId])
  @@index([status, expiresAt])
  @@map("payments")
}

// Log setiap notifikasi / webhook dari gateway (untuk audit & debugging)
model PaymentWebhookLog {
  id         String         @id @default(cuid())
  paymentId  String?
  gateway    PaymentGateway
  eventType  String? // settlement, pending, expire, deny, dll
  externalId String?
  payload    Json
  signature  String?
  isValid    Boolean        @default(false) // hasil verifikasi signature
  processed  Boolean        @default(false)
  errorMessage String?
  receivedAt DateTime       @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([externalId])
  @@index([processed])
  @@map("payment_webhook_logs")
}

model Refund {
  id         String       @id @default(cuid())
  orderId    String
  paymentId  String?
  amount     Decimal      @db.Decimal(12, 2)
  reason     String
  status     RefundStatus @default(REQUESTED)
  externalRefundId String? // id refund dari gateway
  processedBy String?
  processedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  order   Order    @relation(fields: [orderId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

// ============================================================
// PENGIRIMAN (KURIR)
// ============================================================

model Delivery {
  id          String         @id @default(cuid())
  orderId     String         @unique
  courierId   String?
  status      DeliveryStatus @default(UNASSIGNED)

  assignedAt  DateTime?
  acceptedAt  DateTime?
  pickedUpAt  DateTime?
  arrivedAt   DateTime?
  deliveredAt DateTime?

  // Bukti pengiriman
  proofPhoto     String?
  receiverName   String?
  receiverSignature String?
  deliveryNote   String?
  failureReason  String? // customer tidak di tempat, dll
  attemptCount   Int      @default(0)

  // Galon yang benar-benar dikembalikan customer
  emptyGallonsCollected Int @default(0)

  // COD
  codAmount      Decimal? @db.Decimal(12, 2)
  codCollected   Boolean  @default(false)

  distanceKm     Float?
  courierFee     Decimal  @default(0) @db.Decimal(12, 2) // upah kurir per antar

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier  CourierProfile? @relation(fields: [courierId], references: [id])
  tracking DeliveryTracking[]

  @@index([courierId, status])
  @@map("deliveries")
}

model DeliveryTracking {
  id         String         @id @default(cuid())
  deliveryId String
  status     DeliveryStatus
  latitude   Float?
  longitude  Float?
  note       String?
  createdAt  DateTime       @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
  @@map("delivery_trackings")
}

// ============================================================
// GALON (DEPOSIT & TUKAR GALON KOSONG)
// ============================================================

model GallonMovement {
  id        String             @id @default(cuid())
  userId    String // customer terkait
  orderId   String?
  type      GallonMovementType
  quantity  Int                @default(0)
  amount    Decimal            @default(0) @db.Decimal(12, 2) // nominal deposit
  note      String?
  createdAt DateTime           @default(now())

  order Order? @relation(fields: [orderId], references: [id])

  @@index([userId, createdAt])
  @@map("gallon_movements")
}

// ============================================================
// LANGGANAN GALON RUTIN
// ============================================================

model Subscription {
  id          String                @id @default(cuid())
  userId      String
  addressId   String
  slotId      String?
  frequency   SubscriptionFrequency
  dayOfWeek   Int? // 0-6 (Minggu-Sabtu) untuk WEEKLY/BIWEEKLY
  dayOfMonth  Int? // 1-28 untuk MONTHLY
  status      SubscriptionStatus    @default(ACTIVE)
  paymentMethod PaymentMethod?
  nextRunAt   DateTime
  lastRunAt   DateTime?
  pausedUntil DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  address Address            @relation(fields: [addressId], references: [id])
  slot    DeliverySlot?      @relation(fields: [slotId], references: [id])
  items   SubscriptionItem[]
  orders  Order[]

  @@index([status, nextRunAt])
  @@map("subscriptions")
}

model SubscriptionItem {
  id             String  @id @default(cuid())
  subscriptionId String
  productId      String
  quantity       Int     @default(1)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@unique([subscriptionId, productId])
  @@map("subscription_items")
}

// ============================================================
// REVIEW
// ============================================================

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  orderId   String
  rating    Int // 1-5
  comment   String?
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])

  @@unique([userId, productId, orderId])
  @@map("reviews")
}

// ============================================================
// NOTIFIKASI, BANNER, SETTING, AUDIT
// ============================================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json? // contoh: { orderId: "..." }
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  image     String
  link      String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("banners")
}

// Pengaturan toko & konfigurasi payment gateway
model Setting {
  key       String   @id // contoh: store_name, midtrans_server_key
  value     String
  group     String   @default("general") // general, payment, shipping
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // CREATE, UPDATE, DELETE, LOGIN, dll
  entity     String // nama model
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}