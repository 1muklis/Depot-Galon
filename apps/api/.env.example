NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_PREFIX=/api/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/galon?schema=public

# Secrets: wajib diisi (minimal 32 karakter), jangan di-commit
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
ENABLE_DOCS=true
ENABLE_JOBS=true

# Upload (storage lokal)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Email (kosongkan SMTP_HOST untuk log ke console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Galon <no-reply@example.com>"
FRONTEND_URL=http://localhost:5173

# Payment
DEFAULT_PAYMENT_GATEWAY=MIDTRANS
PAYMENT_EXPIRY_MINUTES=1440
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_IS_PRODUCTION=false
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_IS_PRODUCTION=false

# Seed (hanya dipakai prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
